{
	email {$ACME_EMAIL}
	servers {
		timeouts {
			read_header 5s
			read_body 10s
			write 60s
			idle 30s
		}
	}
}
{$AI_DOMAIN} {
	request_body {
		max_size 64KB
	}
	header {
		X-Content-Type-Options nosniff
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
	@api path /v1/chat /healthz
	reverse_proxy @api gateway:8080 {
		flush_interval -1
		transport http {
			dial_timeout 3s
			response_header_timeout 52s
		}
	}
	respond 404
}
