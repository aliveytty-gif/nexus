# Supabase Project Settings > API / Connect. Public key only, never service_role.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy projects may use NEXT_PUBLIC_SUPABASE_ANON_KEY instead.
# Local development. On Vercel set the public HTTPS production URL before build.
# If omitted on Vercel, VERCEL_PROJECT_PRODUCTION_URL supplies that URL.
NEXT_PUBLIC_SITE_URL=

# Enable after configuring the Reset Password template and redirect (see README).
AUTH_PASSWORD_RECOVERY_ENABLED=

# Server only. See docs/ai/README.md for setup, defaults, and cost limits.
AI_ENABLED=
AI_PROVIDER=
# Set true only after verifying this Groq organization uses Free without billing.
AI_GROQ_FREE_CONFIRMED=
OPENROUTER_API_KEY=
AI_API_KEY=
AI_API_BASE_URL=
AI_MODEL=
AI_FALLBACK_MODEL=
AI_ALLOW_PAID=
AI_MAX_REQUEST_COST=
AI_INPUT_PRICE_PER_MILLION=
AI_OUTPUT_PRICE_PER_MILLION=
AI_DAILY_USER_LIMIT=
AI_DAILY_GLOBAL_LIMIT=
AI_MAX_OUTPUT_TOKENS=
AI_MAX_INPUT_BYTES=
AI_MAX_TOOL_STEPS=
AI_MAX_TOOL_CALLS=
AI_REQUEST_TIMEOUT=
AI_REASONING_SUPPORTED=
AI_REASONING_EFFORT=
AI_DISABLED_TOOLS=
# Optional development only; localhost/127.0.0.1, disabled on Vercel.
OLLAMA_BASE_URL=

# Optional search provider: firecrawl or brave. The key stays on the server.
WEB_SEARCH_PROVIDER=
WEB_SEARCH_API_KEY=
WEB_SEARCH_COST_PER_REQUEST=
AI_MAX_SEARCH_CALLS=
AI_MAX_SEARCH_COST=
