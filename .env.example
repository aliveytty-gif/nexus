# Supabase Project Settings > API / Connect. Public key only, never service_role.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy projects may use NEXT_PUBLIC_SUPABASE_ANON_KEY instead.
# Local development. On Vercel set the public HTTPS production URL before build.
# If omitted on Vercel, VERCEL_PROJECT_PRODUCTION_URL supplies that URL.
NEXT_PUBLIC_SITE_URL=

# Server only. Defaults below are documented in docs/ARCHITECTURE.md.
AI_ENABLED=
AI_PROVIDER=
AI_MODEL=
AI_GATEWAY_URL=
AI_GATEWAY_TOKEN=
AI_STREAMING=
# Optional owner-written additions to the built-in NEXUS persona. Server only.
AI_SYSTEM_INSTRUCTIONS=
AI_DAILY_USER_LIMIT=
AI_DAILY_GLOBAL_LIMIT=
AI_MAX_OUTPUT_TOKENS=
# Explicit legacy provider only; not required for self-hosted Ollama.
OPENROUTER_API_KEY=
AI_FALLBACK_MODEL=
